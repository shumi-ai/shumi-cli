# Shumi CLI — environment variables (all optional)

# --- API endpoints -----------------------------------------------------------
# Override the data API base (defaults to the hosted coinrotator-ai endpoint).
# SHUMI_API_URL=https://coinrotator-ai.onrender.com/api/cli
# Override the API-key management endpoint.
# SHUMI_KEYS_URL=https://coinrotator.app/api/keys

# --- Auth --------------------------------------------------------------------
# Bearer token / API key for non-interactive use (CI, bots, servers).
# SHUMI_TOKEN=shumi_sk_...

# --- x402 pay-per-query ------------------------------------------------------
# SHUMI_X402_PRIVATE_KEY=0x...        # signer for non-interactive payments
# SHUMI_MAX_PRICE_USDC=0.10           # per-call price ceiling
# SHUMI_DAILY_USDC_CAP=1.00           # per-day spend cap
# SHUMI_AUTO_PAY=1                    # pay paywalls without prompting

# --- Telemetry (PostHog) -----------------------------------------------------
# The CLI sends anonymous, privacy-preserving usage telemetry (command names,
# flag names, durations, status codes — never your queries, keys, or tokens).
# Distinct id is an anonymous machine fingerprint.
#
# Opt out completely with either of these (no telemetry is sent):
#   SHUMI_TELEMETRY=0
#   …or set "telemetry_opt_out": true in ~/.shumi/config.json
#
# Self-host the collector / override credentials (defaults are baked in):
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://t.shumi.ai
# SHUMI_TELEMETRY=0

# --- Other -------------------------------------------------------------------
# SHUMI_AGENT=1                       # machine mode: JSON output, no spinner/color
# SHUMI_NO_UPDATE_NOTIFIER=1          # suppress the update-available notice
