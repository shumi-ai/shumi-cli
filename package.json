{
  "name": "shumi",
  "version": "0.6.2",
  "description": "Shumi — crypto trade intelligence from your terminal",
  "type": "module",
  "bin": {
    "shumi": "bin/shumi.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/shumi.js",
    "dev": "node --watch bin/shumi.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "crypto",
    "trading",
    "cli",
    "shumi",
    "coinrotator",
    "ai-agent",
    "mcp"
  ],
  "author": "CoinRotator",
  "license": "MIT",
  "homepage": "https://shumi.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayrsascha/shumi-cli.git"
  },
  "bugs": {
    "url": "https://github.com/mayrsascha/shumi-cli/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.2.1",
    "nanoid": "^5.0.9",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "posthog-node": "^5.38.6",
    "update-notifier": "^7.3.1",
    "viem": "^2.52.2",
    "x402-fetch": "^1.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "execa": "^9.5.2",
    "vitest": "^2.1.8"
  }
}
